<o:UseCase Id="o65">
<a:ObjectID>92B8731C-87DE-4109-B578-A141B125ADC0</a:ObjectID>
<a:Name>Dodavanje sednice</a:Name>
<a:Code>Dodavanje_sednice</a:Code>
<a:CreationDate>1759396194</a:CreationDate>
<a:Creator>Dovvahkiin</a:Creator>
<a:ModificationDate>1759407220</a:ModificationDate>
<a:Modifier>Dovvahkiin</a:Modifier>
<a:Step>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs20\lang9242 1. Administrator pokre\&#39;e6e kreiranje sednice\par
2. Sistem pokre\&#39;e6e formu za unos podataka nove sednice\par
3. Administrator vr\&#39;9ai unos podataka sednice\par
4. Ako nisu uneti podaci sednice &lt;exception&gt;  Morate uneti sve podatke\line Onda\par
5. Sistem nudi pociju za tabelarni prikaz podataka &lt;access&gt; Tabelarni prikaz podataka o sednicama\par
6. Sistem nudi opciju filtriranja podataka &lt;extend&gt; Filter podataka po ID-u sednice\par
7. Sistem nudi opciju \&#39;9atampe podataka &lt;extend&gt; Filter podataka po ID-u sednice\par
8. Ako koirisnik odabere opciju tabelarni prikaz onda &lt;Filter podataka po ID-u sednice&gt;\par
9. Ako korisnik odabere opciju \&#39;9atampanja onda &lt;\&#39;8atampa podataka o sednici&gt;\par
10. Slu\&#39;e8aj kori\&#39;9a\&#39;e6enja se zavr\&#39;9aava\f1\lang1033\par
}
</a:Step>
<a:UseCase.Extension>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs20\lang9242 &lt;extend&gt; Filter podataka po ID-u sednice\par
\f1\lang1033\par
}
</a:UseCase.Extension>
<a:Throws>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs20\lang9242 &lt;exception&gt;  Morate uneti sve podatke\line Sistem ispisuje poruku validacije\par
\f1\lang1033\par
}
</a:Throws>
<a:PreCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs20\lang9242 Provera prethodnih sednica\f1\lang1033\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs20\lang9242 Upisani podaci o novoj sednici\f1\lang1033\par
}
</a:PostCondition>
</o:UseCase>
